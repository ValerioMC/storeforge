  "narrative": {
    "northStar": "Accession Register",
    "overview": "The workspace pairs a deep navy connection rail with cool white work surfaces, using the European Space Agency palette as a reference. The supplied bucket-and-anvil mark anchors the brand.\n\nDense object lists and property rows are divided by fine rules. The active connection, current path, selected object, and operation results have distinct places so operators can verify what they are working on.",
    "keyCharacteristics": [
      "Navy connection rail and cyan interaction states",
      "Task-focused tables and property lists",
      "Flat work surfaces and restrained overlays"
    ],
    "rules": [],
    "dos": [
      "Do keep the selected endpoint and exact storage context visible near actions.",
      "Do use fine dividers and cool surface changes to group data.",
      "Do pair status colors with labels and preserve clear keyboard focus."
    ],
    "donts": [
      "Don't use shadows to separate resting table rows or settings sections.",
      "Don't use the saturated rail accent as body text on light surfaces."
    ]
  }
}
